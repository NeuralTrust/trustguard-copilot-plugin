# Optional: deploy as root-owned file and point the install script at it
# (default path: /Library/Managed Preferences/ai.neuraltrust.trustguard-copilot.env)
#
# Kandji: separate Custom Script / file drop, or paste values into the
# install script CONFIG block instead.

TRUSTGUARD_DATA_URL=https://data.example.neuraltrust.ai
TRUSTGUARD_API_KEY=tgk_YOUR_ORG_COPILOT_COLLECTOR_KEY
TRUSTGUARD_FAIL_MODE=closed

# Pin release (recommended).
TRUSTGUARD_COPILOT_VERSION=0.1.0
TRUSTGUARD_BINARY_SHA256=REPLACE_WITH_RELEASE_ASSET_SHA256

# Optional:
# TRUSTGUARD_TIMEOUT_MS=5000
# TRUSTGUARD_TRANSFORM_ACTION=ask
# TRUSTGUARD_LOCAL_BINARY=/path/to/staged/binary

# Optional stable attribution. Omit to leave consumer_id empty.
# TRUSTGUARD_CONSUMER_ID=developer@example.com
